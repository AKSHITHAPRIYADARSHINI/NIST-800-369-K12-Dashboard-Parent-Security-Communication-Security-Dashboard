// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String      @id @default(cuid())
  fullName              String
  email                 String      @unique
  passwordHash          String
  role                  Role        @relation(fields: [roleId], references: [id])
  roleId                String
  accountStatus         AccountStatus @default(ACTIVE)
  mfaEnabled            Boolean     @default(false)
  mfaType               MFAType?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  lastLoginAt           DateTime?
  lastPasswordChangeAt  DateTime?

  sessions              Session[]
  mfaSecret             MFASecret?
  auditLogs             AuditLog[]
}

model Role {
  id          String    @id @default(cuid())
  roleName    String    @unique
  description String?
  createdAt   DateTime  @default(now())

  users               User[]
  rolePermissions     RolePermission[]
}

model Permission {
  id                String    @id @default(cuid())
  permissionKey     String    @unique
  permissionLabel   String
  resource          String?
  action            String?
  createdAt         DateTime  @default(now())

  rolePermissions   RolePermission[]
}

model RolePermission {
  id            String  @id @default(cuid())
  role          Role    @relation(fields: [roleId], references: [id])
  roleId        String
  permission    Permission @relation(fields: [permissionId], references: [id])
  permissionId  String
  createdAt     DateTime @default(now())

  @@unique([roleId, permissionId])
}

model Session {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  sessionToken  String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  ipAddress     String?
  userAgent     String?
}

model MFASecret {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String    @unique
  mfaType         MFAType
  secretEncrypted String
  recoveryCode    String?
  enabled         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id          String    @id @default(cuid())
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
  action      String
  targetType  String?
  targetId    String?
  changes     Json?
  ipAddress   String?
  timestamp   DateTime  @default(now())
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MFAType {
  EMAIL_OTP
  AUTHENTICATOR
}

enum DeviceType {
  LAPTOP
  DESKTOP
  TABLET
  CHROMEBOOK
  SERVER
  PRINTER
  OTHER
}

enum PatchStatus {
  CURRENT
  PENDING
  OVERDUE
  CRITICAL
}

enum EncryptionStatus {
  ENABLED
  DISABLED
  PARTIAL
}

enum AntivirusStatus {
  ACTIVE
  INACTIVE
  OUTDATED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataSensitivity {
  LOW
  MEDIUM
  HIGH
}

enum VendorRiskRating {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VendorRiskStatus {
  APPROVED
  UNDER_REVIEW
  AT_RISK
  REJECTED
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  PENDING
  TERMINATED
}

enum VendorRecommendation {
  APPROVE
  REJECT
  REASSESS
  CONDITIONAL
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  REMEDIATING
  RESOLVED
  CLOSED
}

enum AccessLogResult {
  SUCCESS
  FAILURE
  BLOCKED
}

enum PolicyCategory {
  AUTHENTICATION
  DATA_PROTECTION
  NETWORK
  DEVICE
  INCIDENT_RESPONSE
  VENDOR
  GOVERNANCE
  AWARENESS
}

enum PolicyStatus {
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
  DRAFT
}

enum AssessmentResult {
  PASS
  PARTIAL
  FAIL
  NA
}

enum ControlStatus {
  DONE
  IN_PROCESS
  NOT_STARTED
  NOT_APPLICABLE
}

enum MaturityLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
}

model ControlMapping {
  id            String        @id @default(cuid())
  controlId     String        @unique
  title         String
  domain        String
  type          String
  status        ControlStatus @default(NOT_STARTED)
  targetScore   Float         @default(100)
  currentScore  Float         @default(0)
  maturityLevel MaturityLevel @default(LEVEL_0)
  evidence      String?
  notes         String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Device {
  id               String           @id @default(cuid())
  deviceId         String           @unique
  name             String
  type             DeviceType
  os               String
  assignedTo       String?
  department       String?
  lastSeen         DateTime?
  patchStatus      PatchStatus      @default(CURRENT)
  encryptionStatus EncryptionStatus @default(DISABLED)
  antivirusStatus  AntivirusStatus  @default(INACTIVE)
  riskScore        Float            @default(0)
  riskLevel        RiskLevel        @default(LOW)
  isArchived       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  alerts           DeviceAlert[]
}

model DeviceAlert {
  id           String    @id @default(cuid())
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId     String
  alertType    String
  severity     RiskLevel
  message      String
  acknowledged Boolean   @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Vendor {
  id              String           @id @default(cuid())
  name            String
  service         String
  dataSensitivity DataSensitivity  @default(LOW)
  riskRating      VendorRiskRating @default(LOW)
  riskStatus      VendorRiskStatus @default(UNDER_REVIEW)
  contractStatus  ContractStatus   @default(PENDING)
  contractExpiry  DateTime?
  lastReview      DateTime?
  dataAccess      String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assessment      VendorAssessment?
}

model VendorAssessment {
  id                String               @id @default(cuid())
  vendor            Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId          String               @unique
  assessmentDate    DateTime
  assessor          String
  ferpaCompliant    Boolean              @default(false)
  coppaCompliant    Boolean              @default(false)
  soc2Certified     Boolean              @default(false)
  penetrationTested Boolean              @default(false)
  dataEncryption    Boolean              @default(false)
  dataResidency     String?
  breachHistory     Boolean              @default(false)
  overallScore      Float                @default(0)
  recommendation    VendorRecommendation @default(REASSESS)
  nextReview        DateTime?
  findings          String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Incident {
  id              String           @id @default(cuid())
  title           String
  type            String
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  assignee        String?
  reportedAt      DateTime         @default(now())
  affectedSystems String?
  affectedUsers   Int              @default(0)
  nextAction      String?
  resolvedAt      DateTime?
  mttr            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          IncidentEvent[]
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String
  timestamp  DateTime @default(now())
  actor      String
  action     String
  notes      String?
}

model AccessLog {
  id        String          @id @default(cuid())
  timestamp DateTime        @default(now())
  userId    String?
  userEmail String
  userRole  String
  action    String
  resource  String
  ipAddress String?
  location  String?
  result    AccessLogResult @default(SUCCESS)
  riskFlag  Boolean         @default(false)

  @@index([timestamp])
  @@index([riskFlag])
}

model SecurityPolicy {
  id           String         @id @default(cuid())
  name         String
  category     PolicyCategory
  status       PolicyStatus   @default(DRAFT)
  lastUpdated  DateTime       @default(now())
  owner        String
  reviewCycle  Int            @default(365)
  nextReview   DateTime?
  version      String         @default("1.0")
  applicableTo String?
  summary      String?
  content      String?
  isArchived   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model DomainScore {
  id               String   @id @default(cuid())
  domain           String   @unique
  score            Float
  trend            Float    @default(0)
  lastCalculatedAt DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  category  String
  updatedBy String?
  updatedAt DateTime @updatedAt
}
